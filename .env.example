# ============================================================
#  FoodWise — Environment Variable Template
#  Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# ─── JWT ────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32_output_here
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ─── Internal Service Token ─────────────────────────────────
# Generate: openssl rand -hex 24
INTERNAL_SERVICE_TOKEN=CHANGE_ME_internal_service_secret

# ─── Auth DB (auth-service) ──────────────────────────────────
AUTH_DB_HOST=auth-postgres
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGE_ME_auth_db_password

# ─── Catalog DB (catalog-order-service) ──────────────────────
CATALOG_DB_HOST=catalog-postgres
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=CHANGE_ME_catalog_db_password

# ─── Inventory DB (inventory-app + notification-worker) ───────
INVENTORY_DB_HOST=inventory-postgres
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=CHANGE_ME_inventory_db_password

# ─── Redis (auth sidecar) ────────────────────────────────────
AUTH_REDIS_HOST=auth-redis
AUTH_REDIS_PORT=6379

# ─── Redis (catalog sidecar) ─────────────────────────────────
CATALOG_REDIS_HOST=catalog-redis
CATALOG_REDIS_PORT=6379

# ─── Redis (inventory sidecar) ───────────────────────────────
INVENTORY_REDIS_HOST=inventory-redis
INVENTORY_REDIS_PORT=6379

# ─── Service URLs (inter-service calls) ──────────────────────
AUTH_SERVICE_URL=http://auth-service:8081
INVENTORY_SERVICE_URL=http://inventory-app:8083

# ─── Mail (Mailhog in dev) ───────────────────────────────────
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@foodwise.local

# ─── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_S=60
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_S=3600

# ─── Surplus Detection ────────────────────────────────────────
SURPLUS_QUANTITY_THRESHOLD=10
SURPLUS_EXPIRY_HOURS=24
NOTIFICATION_POLL_INTERVAL_MS=60000

# ─── Frontend (nginx reverse proxy paths — do not use localhost) ──
VITE_API_BASE_URL=/api/auth
VITE_CATALOG_API_URL=/api/catalog
VITE_INVENTORY_API_URL=/api/inventory
